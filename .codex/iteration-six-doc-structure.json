  },
  {
    "p": 415,
    "start": 4214,
    "end": 4225,
    "style": "正文",
    "list": "4",
    "table": false,
    "text": "非功能性需求（选填）"
  },
  {
    "p": 416,
    "start": 4225,
    "end": 4286,
    "style": "正文",
    "list": "",
    "table": false,
    "text": "请填写涉及的非功能性需求（包括但不限于对于数据、安全、性能、容量、业务连续性、灾备、监控、可靠性、易用性等方面的要求。）"
  }
